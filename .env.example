# Copy this file to .env and replace every placeholder with your real value.
# Never commit .env or put real credentials in this file.

# GitHub
GITHUB_TOKEN=your_github_personal_access_token
# Must match the Secret configured in your GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Groq / LLM
GROQ_API_KEY=your_groq_api_key
GROK_MODEL=openai/gpt-oss-120b

# Application
ADMIN_TOKEN=your_admin_token
TARGET-REPO=Vehicle-Insurance-with-MLOPS

# Indexing
index_on_push=True
INDEX_BRANCH=main

# FalkorDB (code graph)
GRAPH_ENABLED=true
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_falkordb_password
GRAPH_NAME=code_graph

# PostgreSQL
POSTGRES_PASSWORD=your_postgres_password
# For Docker Compose, use the PostgreSQL service name as the hostname (e.g. postgres).
DATABASE_URL=postgresql://pr_reviewer:${POSTGRES_PASSWORD}@postgres:5432/pr_reviewer

# Redis
REDIS_URL=redis://localhost:6378/0
REDIS_PASSWORD=your_redis_password
